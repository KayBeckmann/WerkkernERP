# Lokale Kopie als `.env` anlegen, NIE committen.

# Phase B Online-Multi-User-Server (server/) — eigene Postgres-Instanz,
# siehe docker-compose.yml und server/README.md.
SERVER_DB_PASSWORD=change-me-server-db

# Mailversand über den Server: Schlüssel für das verschlüsselt
# gespeicherte SMTP-Passwort der Firmen (32 Byte, Base64). Ohne ihn ist
# der Mailversand abgeschaltet. Erzeugen: openssl rand -base64 32
# Verlust = gespeicherte SMTP-Passwörter neu eingeben; sicher aufbewahren
# (pass/KeePassXC), nicht ins Backup-Repo.
# SERVER_SECRET_KEY=

# Produktion mit TLS-Proxy (docker compose --profile tls up -d):
# SERVER_DOMAIN=erp.example.org
# SERVER_BIND=127.0.0.1
# SERVER_TRUST_PROXY=true
# SERVER_CORS_ALLOWED_ORIGINS=https://app.example.org
